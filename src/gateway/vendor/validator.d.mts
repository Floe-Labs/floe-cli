/**
 * Types of the vendored gateway-export validator (validator.mjs, generated by
 * scripts/sync-gateway-validator.sh from floe-monorepo). Hand-written: keep in
 * step with apps/api/src/services/ext-gateway/validate-core.ts.
 */

export interface ValidationReport {
  valid: boolean;
  format: 'csv' | 'ndjson';
  profile: { template: string; source: 'connection' | 'template' | 'best_match' } | null;
  exportRowCount: number;
  floeRowCount: number;
  rowCountMatches: boolean;
  ids: 'present' | 'derived' | null;
  headers: { mapped: string[]; ignored: string[]; unmapped: string[]; missingRequired: string[] };
  refusedRows: { count: number; reasons: Record<string, number>; rows: Array<{ row: number; reason: string; field?: string }>; truncated: boolean } | null;
  skippedRows: { count: number; reasons: Record<string, number> };
  duplicateIds: { inFile: { count: number; rows: number[]; truncated: boolean } };
  bestTemplate: { template: string; score: number; missingRequired: string[] } | null;
  templates: Array<{ template: string; score: number; missingRequired: string[] }>;
  fileError: { error: string; detail: string } | null;
  notes: string[];
}

export function validateGatewayFile(input: { text: () => AsyncIterable<string>; template?: string }): Promise<{ report: ValidationReport }>;
/** CFO B1: a header shown as itself only when it reads like a name; else `column <n>` / `key <n>`. */
export function headerLabel(name: string, index: number, format: 'csv' | 'ndjson'): string;
export function decodeChunks(bytes: AsyncIterable<Uint8Array>): AsyncGenerator<string>;
export function contractJsonSchema(version: string): Record<string, unknown> | null;
export const CONTRACT_VERSIONS: readonly number[];
export const CONTRACT_TEMPLATES: { readonly ndjson: string; readonly csv: string };
export const IDS_DERIVED_NOTE: string;
export const LIST_LIMIT: number;
