# Floe CLI environment variables — all optional; env vars always win over the keychain.
# Headless / CI usage: set the keys here instead of running `floe init`.

# Developer key (floe_live_...) — account-level operations: agents, keys, billing, webhooks
FLOE_API_KEY=

# Agent runtime key (floe_...) — metered calls: chat, embed, speak, transcribe, pay
FLOE_AGENT_KEY=

# Override the API base URL (default: https://credit-api.floelabs.xyz)
# FLOE_API_URL=https://credit-api.floelabs.xyz
